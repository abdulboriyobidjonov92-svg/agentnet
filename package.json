{
  "name": "agentnet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check:vercel-config": "node scripts/check-vercel-config.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "packageManager": "npm@10.9.2",
  "allowScripts": {
    "@clerk/shared@3.47.7": true,
    "@nestjs/core@10.4.22": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
