# ============================================================
# AgentNet — Environment Variables
# Nusxa ko'chirib .env.local ga saqlang, haqiqiy qiymatlarni kiriting.
# HECH QACHON bu faylni haqiqiy qiymatlar bilan git'ga commit qilmang!
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://agentnet:password@localhost:5432/agentnet_dev"

# --- Phase 6: Redis (IXTIYORIY, lekin ko'p instansda TAVSIYA ETILADI) ---
# Berilmasa: throttler jarayon-ichi saqlagichga, cron esa qulfsiz rejimga
# qaytadi — platforma ISHLAYVERADI, faqat ko'p-instansli kafolatlarni
# yo'qotadi (limit instanslarga BO'LINADI, cron DUBLIKAT ishlaydi).
# TLS uchun `rediss://` (Upstash va shunga o'xshashlar shuni beradi) —
# `ioredis` TLS'ni sxemadan O'ZI aniqlaydi, qo'shimcha sozlama shart emas.
REDIS_URL="rediss://default:your_token_here@your_host.upstash.io:6379"

# --- Clerk (webhook sinxronizatsiyasi uchun hali ishlatiladi, lekin login endi OTP orqali) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Login OTP (real autentifikatsiya — dev-login o'rniga) ---
#
# Prod'da KAMIDA BITTA login kanali SHART (aks holda server ishga tushmaydi):
#   • RESEND_API_KEY                  (email, Resend)
#   • GMAIL_USER + GMAIL_APP_PASSWORD (email, Gmail SMTP)
#   • ESKIZ_EMAIL + ESKIZ_PASSWORD    (telefon, SMS)
#
# QAYSI PROVAYDER TANLANADI:
#   1. `EMAIL_PROVIDER` aniq berilsa — o'sha (sozlanmagan bo'lsa xato beradi,
#      JIMGINA boshqasiga o'tmaydi);
#   2. berilmasa — Gmail (sozlangan bo'lsa), aks holda Resend.
EMAIL_PROVIDER=""          # "resend" | "gmail" | bo'sh (avtomatik)

# Email-OTP #1: Resend (https://resend.com).
# DIQQAT: Resend IXTIYORIY foydalanuvchiga yuborish uchun DOMEN
# TASDIQLASHNI talab qiladi (Domains -> SPF/DKIM). Domen tasdiqlanmagan
# bo'lsa `validation_error` qaytadi va ro'yxatdan o'tish HECH KIM uchun
# ishlamaydi. `onboarding@resend.dev` faqat Resend hisobingiz manziliga
# yuboradi — ya'ni "hamma kira olsin" uchun YETARLI EMAS.
RESEND_API_KEY=
RESEND_FROM_EMAIL="AgentNet <login@agentnet.app>"

# Email-OTP #2: Gmail SMTP — VAQTINCHALIK ko'prik (domen tasdiqlanmaguncha).
# Domen talab qilmaydi va istalgan manzilga yuboradi.
# CHEKLOV: Gmail kuniga ~500 xat bilan chegaralangan va tranzaksion pochta
# uchun mo'ljallanmagan — domen tasdiqlangach `EMAIL_PROVIDER=resend` ga
# qaytiladi.
# GMAIL_APP_PASSWORD — oddiy parol EMAS: Google hisobida 2FA yoqilgan
# bo'lishi va https://myaccount.google.com/apppasswords dan 16 belgili
# "App password" yaratilishi kerak (bo'sh joysiz kiriting).
# Yuboruvchi manzil HAR DOIM GMAIL_USER bo'ladi — Gmail uni o'zgartirishga
# ruxsat bermaydi, shuning uchun bu rejimda RESEND_FROM_EMAIL ishlatilmaydi.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# SMS-OTP: Eskiz.uz — ikkalasi ham bo'lmasa, telefon orqali kirish
# API'da avtomatik o'chirilgan holda qoladi (email hali ham ishlaydi).
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_SMS_FROM="4546"

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Gemini (agent-engine ikkinchi LLM provayderi) ---
# ANTHROPIC_API_KEY bo'lsa hech qachon ishlatilmaydi (Anthropic doim ustuvor).
# Faqat ANTHROPIC_API_KEY bo'lmaganda umumiy `llm_json()` fallback sifatida
# ishlaydi. MUHIM: Computer-Use (Qurilma Boshqaruvi -> Kompyuter agenti,
# skrinshot->harakat) hozircha FAQAT Gemini orqali ishlaydi (vision) — u
# ANTHROPIC_API_KEY o'rnatilgan bo'lsa ham shu funksiya uchun alohida SHART.
GEMINI_API_KEY=""
# Muqobil nom (ikkalasidan biri yetarli)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- API URLs ---
# PRODUCTION (Vercel) uchun MAJBURIY — NestJS API ning OMMAVIY URL i,
# masalan "https://agentnet-api.onrender.com". Qo'yilmasa BUTUN login
# oqimi sinadi (middleware /api/backend/* ni localhost ga rewrite qiladi).
# DIQQAT: NEXT_PUBLIC_* build vaqtida INLINE qilinadi — Vercel da
# o'zgartirgandan keyin QAYTA DEPLOY shart, aks holda eski qiymat qoladi.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# agent-engine manzili. SEC-10/ADR-021 dan keyin buni FAQAT NestJS API o'qiydi —
# frontend (Next.js BFF) engine'ga umuman bormaydi, chat oqimi API orqali o'tadi
# (`POST /api/agents/stream`). Ya'ni Vercel'da bu env KERAK EMAS.
#   • Lokal:   http://localhost:8000  (quyidagi default — hech narsa o'zgarmaydi)
#   • Render (SEC-10): engine `type: pserv` (private service) — OMMAVIY URL YO'Q.
#     Qiymat xususiy tarmoq manzili bo'ladi, protokol bilan:
#       http://<internal-host>:8000
#     Manzilni Render → agentnet-engine → Connect → Internal dan olasiz
#     (masalan `agentnet-engine-2j3e:8000`). Prod'da bu env bo'lmasa API
#     boot bo'lmaydi (validateEnv fail-closed).
AGENT_ENGINE_URL="http://localhost:8000"

# --- Bank integrations (sandbox) ---
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# --- Storage (Cloudflare R2 / S3 compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="agentnet-files"

# --- Messaging ---
TELEGRAM_BOT_TOKEN=""
# SEC-11 §6.5(6): xavfli admin amallari signali yuboriladigan kanal/guruh
# chat id. Bo'sh bo'lsa signal YO'QOLMAYDI — strukturaviy log sifatida
# yoziladi (AdminAlertService). Infratuzilma sozlamasi, sir emas.
OWNER_ALERT_TELEGRAM_CHAT_ID=""
# Bot username (@ belgisisiz) — hisob-bog'lash havolasini qurish uchun (https://t.me/<username>?start=...)
TELEGRAM_BOT_USERNAME=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Camera / CV service ---
CAMERA_SERVICE_URL="http://localhost:8001"

# --- App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Ichki (server-to-server) kalit ---
# Servislararo chaqiruvlar: agent-engine -> API (web.automate, connector.invoke)
# VA Next.js BFF -> API /billing/refund (balansni oshiradi — himoya SHART).
# PRODUCTION'da default/bo'sh qiymat QABUL QILINMAYDI (InternalTokenGuard rad etadi) —
# `openssl rand -hex 32` bilan kuchli kalit yarating va uni api + web + agent-engine
# .env fayllarida BIR XIL qiymat qilib qo'ying. Dev'da default o'zi ishlaydi.
INTERNAL_API_TOKEN=agentnet-internal-dev
# Engine dan NestJS ga yol (agent-engine .env)
API_URL=http://localhost:3001

# --- Rate limiting / xarajat himoyasi (api .env) ---
# Per-user kunlik limitlar tarifga qarab (free / pro)
USAGE_FREE_CHAT_PER_DAY=20      # bepul: kuniga 20 xabar
USAGE_FREE_AGENTS_MAX=5         # bepul: jami 5 agent
USAGE_PRO_CHAT_PER_DAY=500      # pro: kuniga 500 xabar
USAGE_PRO_AGENTS_MAX=100        # pro: jami 100 agent
# Global kunlik LLM chegarasi — ko'p akkaunt/abuse'ga qarshi so'nggi himoya.
# Yetganda hamma uchun to'xtaydi (kutilmagan katta hisobning oldini oladi).
USAGE_GLOBAL_LLM_PER_DAY=2000
USAGE_GLOBAL_LLM_ALERT=1600     # 80% da log-ogohlantirish

# --- Tool-use loop chegarasi (agent-engine .env) ---
# Bitta so'rov ichida reason->tool->reason sikli maksimal necha marta aylanadi
AGENT_MAX_TOOL_ITERATIONS=8

# --- Prepaid billing (api .env) — foydalanuvchi o'zi uchun to'laydi ---
# Bitta xabar narxi (UZS tiyin). Balans yetarli bo'lmasa LLM so'rovi
# UMUMAN yubormaydi — platforma egasi hech qachon xarajat qilmaydi.
BILLING_PRICE_PER_MESSAGE_TIYIN=50000
# Pro tarif 30 kunlik narxi (UZS tiyin) — prepaid balansdan yechiladi
BILLING_PRO_MONTH_TIYIN=2500000
# Payme Business (kassa) hisobingiz — checkout.paycom.uz orqali. Bo'lmasa
# to'ldirish funksiyasi aniq xato beradi (soxta muvaffaqiyat ko'rsatmaydi).
PAYME_TEST_MODE=true

# --- Sessiya tokeni (imzolash uchun maxfiy kalit) ---
# Prod uchun SHART. `openssl rand -hex 48` bilan yarating. Bo'sh bo'lsa server
# har restartda tasodifiy kalit ishlatadi (tokenlar bekor bo'ladi).
AUTH_JWT_SECRET=""

# --- At-rest shifrlash (api .env) ---
# Connector tokenlari, 2FA TOTP sirlari, brauzer sessiyalari va qo'ng'iroq
# yozuvlari DB'da AES-256-GCM bilan shifrlanadi.
# 32 bayt (64 hex): `openssl rand -hex 32`. PROD uchun SHART — bo'sh bo'lsa
# server ishga tushmaydi (sirlar himoyasiz qolmasligi uchun). Dev'da bo'sh
# bo'lsa barqaror derivativ kalit ishlatiladi (faqat dev uchun).
ENCRYPTION_KEY=""

# --- SEC-14: kalit rotatsiyasi ---
# Shifrmatn `<versiya>:<iv>:<tag>:<ct>` ko'rinishida saqlanadi va VERSIYA
# qaysi kalit bilan ochilishini bir ma'noda aytadi.
#
# Oddiy ish rejimida quyidagi TO'RTTASI ham BO'SH qoladi (default `v1`).
# Faqat ROTATSIYA oynasida to'ldiriladi:
#
#   ENCRYPTION_KEY=<YANGI kalit>            ENCRYPTION_KEY_VERSION=v2
#   ENCRYPTION_KEY_PREVIOUS=<ESKI kalit>    ENCRYPTION_KEY_PREVIOUS_VERSION=v1
#
# So'ng: `node scripts/rotate-encryption-key.mjs --apply` (apps/api).
# Rotatsiya tasdiqlangach ESKI kalit ikki qatori olib tashlanadi.
# To'liq tartib: docs/runbooks/secret-rotation.md
ENCRYPTION_KEY_VERSION=""
ENCRYPTION_KEY_PREVIOUS=""
ENCRYPTION_KEY_PREVIOUS_VERSION=""

# ================================================================
# PHASE 5 — OBSERVABILITY & OPERATIONS
# ================================================================
# Barcha qiymatlar IXTIYORIY: birortasi ham to'ldirilmasa ilova
# to'liq, hech qanday xulq farqisiz ishlaydi (kuzatuv o'chiq bo'ladi).
# DSN HECH QACHON kodga yozilmaydi — faqat shu yerdan/Render env'dan.

# --- P5.1: Sentry (uch servis) ---
# SERVER tomoni (NestJS API, Next.js server+edge, agent-engine).
# Bo'sh bo'lsa SDK umuman init qilinmaydi.
SENTRY_DSN=""
# BRAUZER tomoni (Next.js klient). ALOHIDA DSN — server DSN'i hech
# qachon brauzer bundle'iga tushmasligi uchun. Sozlansa, CSP
# `connect-src` ga uning origin'i AVTOMAT qo'shiladi (fail-closed).
NEXT_PUBLIC_SENTRY_DSN=""
# Muhit yorlig'i (Sentry UI filtri). Bo'sh bo'lsa NODE_ENV ishlatiladi.
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Reliz identifikatori (odatda git commit SHA) — stack-trace'ni to'g'ri
# source-map bilan bog'lash uchun.
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_RELEASE=""
# Tracing namunasi: 0..1. Default 0 (faqat xatolar yuboriladi — arzon).
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# Favqulodda o'chirgich: "0" bo'lsa DSN bo'lsa ham yuborilmaydi.
SENTRY_ENABLED=""
NEXT_PUBLIC_SENTRY_ENABLED=""
# Source-map yuklash (FAQAT web build'i). Token BO'LMASA yuklash
# butunlay o'chadi va build normal davom etadi. Token bo'lsa map'lar
# Sentry'ga yuklanib, build chiqishidan O'CHIRILADI (ommaviy URL'da
# manba kodi qolmaydi).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- P5.2: strukturaviy log (pino, API) ---
# Bo'sh bo'lsa: prod=info, dev=debug, test=silent.
LOG_LEVEL=""

# --- P5.3: request-id propagatsiyasi ---
# API: kiruvchi `x-request-id` FORMATGA MOS bo'lsa qabul qilinadi.
# "0" — umuman qabul qilinmaydi (har so'rovga server ID beradi).
TRUST_INCOMING_REQUEST_ID=""
# BFF (web): BRAUZER bergan `x-request-id` ga ishonish. SUKUT BO'YICHA
# O'CHIQ — faqat "1" bo'lsa yoqiladi.
TRUST_CLIENT_REQUEST_ID=""

# --- P5.4: alertlar ---
# Yetkazish kanali — SEC-11 dan beri mavjud AYNI env ishlatiladi:
#   OWNER_ALERT_TELEGRAM_CHAT_ID (yuqorida) + TELEGRAM_BOT_TOKEN.
# Kanal sozlanmasa signal FAQAT logga tushadi va "yuborildi" DEB
# HISOBLANMAYDI (soxta muvaffaqiyat yo'q).
# "0" — baholovchi cron umuman ishlamaydi.
ALERTS_ENABLED=""
# Chegaralar (biznes qarori — bo'sh bo'lsa defaultlar ishlatiladi):
ALERT_PAYMENT_MIN_FAILURES="5"      # 15 daq oynada bekor qilingan to'lov soni
ALERT_PAYMENT_FAILURE_RATIO="0.5"   # ...va ularning ulushi
ALERT_AGENT_MIN_FAILURES="5"        # 15 daq oynada `failed` AutomationRun
ALERT_AGENT_FAILURE_RATIO="0.5"
ALERT_SERVER_ERROR_MIN="20"         # 5 daq oynada 5xx javoblar
ALERT_AUTH_FAILURE_MIN="100"        # 15 daq oynada 401/403 javoblar
ALERT_DB_CONSECUTIVE_FAILURES="2"   # ketma-ket muvaffaqiyatsiz DB tekshiruvi

# --- P5.5: sog'liq endpointlari ---
# Natija shuncha ms keshlanadi (health DDoS vektoriga aylanmasin).
HEALTH_CACHE_MS="5000"
HEALTH_DB_TIMEOUT_MS="2000"
HEALTH_ENGINE_TIMEOUT_MS="2000"
