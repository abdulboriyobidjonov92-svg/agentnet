// AgentNet — Prisma Schema
// Models: User, Org, Agent, Conversation, AuditLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 3 (A14) bajarildi: holat/tur maydonlari enum'ga o'tkazildi (quyida).
// `UserRole` SEC-05 doirasida oldinroq enum bo'lgan — u avtorizatsiya kaliti.
//
// ATAYLAB `String` qolganlar (A14 ro'yxatida yo'q — kelajakda alohida ADR
// bilan ko'riladi): `User.plan` (free|pro — obuna tizimi qayta ko'rilmoqda),
// `Org.kind`, `Goal.status`, `GoalTask.status`, `OrgCommand.status`,
// `AutomationRun.status`, `DeviceCompanion.status`, `CreatorLedger.kind`,
// `UsageCounter.kind` va vertikal modul holatlari.

/// Rol ierarxiyasi: OWNER > ADMIN > SUPPORT > MEMBER > VIEWER
/// (Engineering Contract A8 / ADR-002). SUPPORT — qo'llab-quvvatlash roli.
/// DIQQAT: bu yerdagi TARTIB `roles.guard.ts`dagi ROLE_RANK bilan mos
/// bo'lishi SHART — ikkalasini birga o'zgartiring.
enum UserRole {
  OWNER
  ADMIN
  SUPPORT
  MEMBER
  VIEWER
}

// ----------------------------------------------------------------
// Phase 3 / Contract A14 (ADR-009) — holat maydonlari `String` emas, `enum`.
// Sabab: `String`da `status = 'runing'` (typo) DB'ga bemalol tushardi va
// admin filtrlarini jimgina buzardi. Endi kafolat DB darajasida.
//
// A'ZO NOMLARI ATAYLAB kichik harfda — jonli ma'lumot va butun kod-baza
// aynan shu qiymatlarni ishlatadi (`'done'`, `'topup'`, ...). Katta harfga
// o'tkazish MA'LUMOT migratsiyasini VA har bir chaqiruv-nuqtasini
// o'zgartirishni talab qilardi — funksional foyda bermaydigan, lekin jonli
// pul/audit yo'llariga tegadigan risk. `UserRole` katta harfda, chunki u
// SEC-05'da nol ma'lumot bilan yangi yaratilgan.
// ----------------------------------------------------------------

/// Platforma obunasi (User.platformPlan).
enum PlatformPlan {
  none
  pro
  max
  max200
  enterprise
}

/// Agent nega muzlatilgan (Agent.frozenReason). `null` = muzlatilmagan.
/// Contract A14 buni "AgentStatus" deb ataydi; sxemada `status` ustuni
/// UMUMAN YO'Q — agent hayot-sikli `frozen Boolean` + shu sabab bilan
/// modellangan. Nom haqiqiy ustunga moslandi, kafolat esa A14 talab
/// qilganicha (DB darajasida) beriladi.
enum AgentFrozenReason {
  trial_expired
  monthly_payment_failed
}

/// Foydalanuvchi fikri holati (Feedback.status).
enum FeedbackStatus {
  new
  seen
  resolved
}

/// Qurilma ruxsati toifasi (DevicePermission.category).
/// Domen `DEVICE_CATEGORIES` (device-control.service.ts) bilan AYNAN bir xil.
enum DeviceCategory {
  browser
  files
  apps
  screen
  calls
  sms
}

/// Qurilma harakat-jurnali toifasi (DeviceActionLog.category).
/// ATAYLAB ALOHIDA enum: jurnal ruxsat-toifalaridan TASHQARI `connect`
/// hodisasini ham yozadi (jonli bazada 9 ta shunday qator bor). Ikkalasini
/// bitta enumga birlashtirish `DevicePermission`ga `connect` yozish yo'lini
/// ochardi — ya'ni A14 sotib olayotgan kafolatning o'zini bo'shashtirardi.
enum DeviceActionCategory {
  browser
  files
  apps
  screen
  calls
  sms
  connect
}

// ----------------------------------------------------------------
// V3-P0 (P0-13 / P0-7) — AGENT IJROSI HODISALARI
//
// Bu uch enum + ikki model (ExecutionRun, ExecutionEvent) —
// `docs/blueprints/P0_BLUEPRINT.md` §2.3 dagi KANONIK hodisa sxemasi.
// UI, trace, admin panel va analytics AYNAN shu manbadan o'qiydi;
// ikkinchi hodisa modeli yozilmaydi.
//
// `AuditLog` (hash-zanjirli) bilan ARALASHTIRILMAYDI: u — "kim nima
// qildi" auditi (ADR-008, zanjir formati muzlatilgan); bu esa "agent
// qanday ishladi" jurnali. Ularni birlashtirish ADR-008 buzilishi.
// ----------------------------------------------------------------

/// Ijro holati (ExecutionRun.status).
enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Hodisa turi (ExecutionEvent.type) — YOPIQ ro'yxat.
/// Yangi qiymat faqat ADR bilan qo'shiladi (blueprint §2.3).
enum ExecutionEventType {
  RUN_STARTED
  MODEL_STARTED
  MODEL_COMPLETED
  TOOL_SELECTED
  POLICY_CHECK
  APPROVAL_REQUIRED
  APPROVAL_GRANTED
  APPROVAL_DENIED
  TOOL_STARTED
  TOOL_RESULT
  TOOL_FAILED
  RETRY_STARTED
  CHECKPOINT_SAVED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
}

/// Hodisani kim keltirib chiqardi (ExecutionEvent.actor).
enum EventActor {
  system
  agent
  user
  admin
}

// ----------------------------------------------------------------
// V3-P0 · P0-6 — POLICY va TASDIQ
// Spetsifikatsiya: docs/strategy/SAFETY_POLICY_LAYER.md §2, §8
// ----------------------------------------------------------------

/// Amal xavflilik darajasi.
///
/// P0 da `LOW`/`HIGH` MAJBURLANADI; `MEDIUM`/`CRITICAL` e'lon qilinadi va
/// yoziladi, lekin alohida oqimga ega bo'lishi V3-P2 da (SAFETY §2.2).
/// Tierni PASAYTIRISH ADR talab qiladi (§2.1.3) — ko'tarish bemalol.
enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Inson qarori.
///
/// ⚠️ `boolean` EMAS: "rad etdi" va "tuzatib tasdiqladi" butunlay boshqa
/// signal. Ularni bitta bayroqqa siqish SAFETY §8 dagi moatni yo'q qiladi.
enum ApprovalDecision {
  APPROVED
  REJECTED
  MODIFIED
}

/// Qurilmaga yuborilgan buyruq turi (DeviceCommand.kind).
enum CommandKind {
  send_sms
  call
  open_app
  computer_use
}

/// Buyruq holati (DeviceCommand.status).
enum CommandStatus {
  queued
  running
  done
  failed
  denied
}

/// Kredit-daftar yozuvi turi (CreditLedger.kind).
enum LedgerKind {
  topup
  usage
  refund
  subscription
  agent_creation
  agent_monthly
  marketplace_install
  creator_bonus
  referral_bonus
  /// SEC-12 — admin tomonidan QO'LDA berilgan kredit. `topup` dan ATAYLAB
  /// ajratilgan: to'lov provayderidan kelgan pul bilan operator qo'li bilan
  /// yozilgan pulni daftar darajasida farqlab bo'lmasa, moliyaviy
  /// solishtirish (§6.2 `/admin/billing/reconcile`) ma'nosini yo'qotadi.
  admin_credit
}

/// SEC-11 §6.5 — xavfli admin amali turi. Har tur `DANGEROUS_ACTIONS`
/// registrida (dangerous-action.registry.ts) o'z avtorizatsiyasi,
/// tasdiqlash-satri va bajaruvchisi bilan e'lon qilinadi.
enum DangerousActionKind {
  role_assign
  session_revoke
  // SEC-12 (Sprint 7 "Users yozish amallari") — qo'lda kredit va blok/blokdan
  // chiqarish. §6.5 nomma-nom faqat "qo'lda kredit >500k so'm"ni xavfli deb
  // ataydi; bu yerda CHEGARADAN QAT'I NAZAR butun pul yo'li oqimga olindi
  // (ikkinchi tasdiqlash mexanizmi yaratmaslik uchun — Rule: bitta oqim).
  // 500k/kun chegarasi ADMIN uchun registrda alohida majburlanadi.
  credit_manual
  user_block
  user_unblock
}

/// SEC-11 §6.5 — holat mashinasi: pending -> executed | cancelled | expired.
/// Boshqa o'tish YO'Q (server tomonda majburlanadi).
enum DangerousActionStatus {
  pending
  executed
  cancelled
  expired
}

/// SEC-11 §6.5 — xavfli amalning DAVOMLI holati.
///
/// NEGA JADVAL KERAK: §6.5 "bekor qilish oynasi"ni talab qiladi, ya'ni amal
/// so'ralgan payt bilan bajarilgan payt ORASIDA holat bo'lishi shart. Uni
/// xotirada saqlash ko'p instansda ishlamaydi (Contract A19/§8) va restartda
/// yo'qoladi — shuning uchun Postgres.
///
/// IKKI BOSQICH: so'rov (pending) -> bajarish (executed). Contract §6.5(5)
/// kechiktirilgan bajarishni FAQAT o'chirish uchun talab qiladi; qolgan
/// amallar darhol bajarilishi mumkin, LEKIN bekor qilish oynasi baribir
/// real: tasdiq `expiresAt` gacha yashaydi va shu vaqt ichida bekor
/// qilinishi mumkin. `executableAfter` — o'chirish sinfi uchun majburiy
/// kutish (24s); hozirgi ikki amalda u `createdAt` ga teng.
model DangerousAction {
  id     String                @id @default(cuid())
  kind   DangerousActionKind
  status DangerousActionStatus @default(pending)

  /// Amalni so'ragan admin (OWNER). Restrict — aktor o'chirilsa xavfli-amal
  /// tarixi jimgina yo'qolmasligi kerak.
  actorId String
  actor   User   @relation("DangerousActionActor", fields: [actorId], references: [id])

  /// Amal qaratilgan foydalanuvchi.
  targetUserId String
  targetUser   User   @relation("DangerousActionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// §6.5(1) — sabab (min 20 belgi, DTO tekshiradi). Auditga ham yoziladi.
  reason String

  /// Amalga xos parametrlar (masalan {"newRole":"ADMIN"}). Sxemasiz
  /// metadata — Rule #29 ruxsat beradi (asosiy biznes obyekti emas).
  payload Json?

  /// Bajarish shu vaqtdan OLDIN mumkin emas (o'chirish sinfi uchun +24s).
  executableAfter DateTime
  /// Shu vaqtdan keyin tasdiq eskiradi — bajarib bo'lmaydi (§6.5 oynasi).
  expiresAt       DateTime

  executedAt    DateTime?
  cancelledAt   DateTime?
  cancelledById String?

  createdAt DateTime @default(now())

  @@index([status, expiresAt])
  @@index([targetUserId])
  @@index([actorId, createdAt])
}

/// SEC-12 §6.6 — impersonation rejimi.
///
/// ATAYLAB BITTA A'ZO. §6.1 matritsasi "Impersonation (write)" ni OWNER uchun
/// ruxsat etadi, LEKIN §6.5 uni XAVFLI AMAL deb tasniflaydi — ya'ni u SEC-11
/// oqimi (sabab + TOTP + yozib tasdiqlash + ikki audit) bilan birga kelishi
/// kerak va SEC-12 doirasiga kirmaydi. Bir a'zoli enum — "yozish rejimi hali
/// mavjud emas" degan kafolatni DB darajasida beradi (A14 mantig'i): hech
/// qanday kod yo'li READ_WRITE qatorini yarata olmaydi, chunki bunday qiymat
/// umuman yo'q. Yozish rejimi qo'shilganda — additive `ALTER TYPE ADD VALUE`.
enum ImpersonationMode {
  READ_ONLY
}

/// SEC-12 — impersonation sessiyasining holati.
/// active -> ended (aniq to'xtatish) | expired (30 daqiqa o'tdi).
/// Boshqa o'tish YO'Q; ikkalasi ham shartli `updateMany` bilan atomik.
enum ImpersonationStatus {
  active
  ended
  expired
}

/// SEC-12 §6.6 — impersonation sessiyasi (server tomonidagi HAQIQAT).
///
/// NEGA JADVAL KERAK, faqat JWT yetarli emas: (a) tokenni BEKOR QILISH
/// (§17 "aniq to'xtatish") imzolangan tokenni qaytarib ololmaydi — server
/// tomonda holat bo'lishi SHART; (b) "har so'rov auditlanadi" (§6.6) uchun
/// sessiya identifikatori davomli bo'lishi kerak; (c) tugash (aniq yoki
/// muddat bilan) farqlanadigan hodisa sifatida yozilishi kerak.
///
/// JWT bu qatorga HAVOLA (`imp` = id) — ikki manba emas, bitta manba +
/// imzolangan havola. Har so'rovda qator o'qiladi va tekshiriladi.
model ImpersonationSession {
  id     String              @id @default(cuid())
  status ImpersonationStatus @default(active)
  mode   ImpersonationMode   @default(READ_ONLY)

  /// HAQIQIY aktor (admin/support). Avtorizatsiya HAR DOIM shu shaxsga
  /// tegishli — `targetUserId` faqat KO'RILAYOTGAN identifikator.
  actorId String
  actor   User   @relation("ImpersonationActor", fields: [actorId], references: [id])

  /// Kimning hisobi ko'rilmoqda.
  targetUserId String
  targetUser   User   @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  /// §6.6 "sabab majburiy" (min 20 belgi — SEC-11 bilan bir xil konvensiya).
  reason String

  /// Aktorning sessiya boshlanganidagi `tokenVersion`i. Har so'rovda joriy
  /// qiymat bilan solishtiriladi: aktorning sessiyalari bekor qilinsa
  /// (SEC-03), impersonation ham SHU ZAHOTI o'ladi. Nishonning
  /// `tokenVersion`i tokenning `tv` da — uni `AuthGuard` allaqachon
  /// tekshiradi, ya'ni nishon sessiyalari bekor qilinsa ham token o'ladi.
  actorTokenVersion Int

  /// §6.6 "maks. 30 daqiqa" — server tomonidagi HAQIQAT (JWT `exp` bilan
  /// bir xil, lekin token o'zgartirilsa ham bu qator o'zgarmaydi).
  expiresAt DateTime

  endedAt     DateTime?
  /// 'manual' (operator to'xtatdi) | 'expired' (muddat) | 'revoked' (aktor
  /// sessiyalari bekor qilindi) — tugash sababi ANIQ farqlanadi (§13).
  endedReason String?

  /// Shu sessiya orqali o'tgan so'rovlar soni (audit yozuvlari bilan
  /// solishtirish uchun tez ko'rsatkich).
  requestCount Int @default(0)

  /// Nishonga bildirishnoma yuborilgan vaqt (§6.6 oxirgi banti). `null` =
  /// hali yuborilmagan yoki kanal yo'q — takror yubormaslik uchun.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([status, expiresAt])
}

/// To'lov maqsadi (PaymeTransaction/ClickTransaction.purpose).
enum PaymentPurpose {
  topup
  platform_subscription
}

model User {
  id           String    @id @default(cuid())
  // SEC-09: Clerk butunlay olib tashlandi (hech qachon haqiqiy auth uchun
  // ishlatilmagan — OTP/dev-login yagona login yo'li). Ustun O'ZI saqlanadi
  // (tarixiy foydalanuvchilarda sintetik `dev_...` qiymat bor, @unique
  // qoladi) — lekin endi MAJBURIY EMAS, kelajakda yangi foydalanuvchi
  // yaratish yo'llari uni umuman to'ldirmasligi mumkin.
  clerkId      String?   @unique
  email        String    @unique
  phone        String?   @unique
  name         String?
  role         UserRole  @default(MEMBER)
  // SEC-03 (Engineering Contract, Phase 1): JWT bekor qilish uchun versiya
  // hisoblagichi. Token payload'idagi `tv` shu qiymatga teng bo'lishi SHART
  // (ClerkGuard tekshiradi) — mos kelmasa 401. Oshirilganda barcha eski
  // tokenlar darhol yaroqsiz bo'ladi (masalan 2FA yoqilganda).
  tokenVersion Int       @default(0)
  // Tarif turi — monetizatsiya poydevori: "free" | "pro"
  plan         String    @default("free")
  // Pro obuna amal qilish muddati — o'tgach limitlar avtomatik free'ga qaytadi
  proUntil     DateTime?

  // --- Platforma obunasi (Pro/Max/Enterprise) — PER-AGENT narxlashdan BUTUNLAY
  // ALOHIDA tizim. Faqat Twin/Fusion/Supermode/Ethics/Knowledge kabi umumiy
  // platforma-intellekt modullariga kirish huquqini beradi; vertikal agentlar
  // (do'kon, avtoservis...) bunga bog'liq emas. Wallet-balansdan EMAS — alohida
  // oylik "kvitansiya" (Payme/Click), hozircha QO'LDA to'lanadi (karta-token
  // avtomatik yechim keyingi bosqich).
  platformPlan           PlatformPlan @default(none)
  platformPlanUntil      DateTime? // joriy to'langan davr oxiri
  platformPlanFrozen     Boolean      @default(false) // muddatida yangilanmadi — kirish to'xtatilgan
  platformReminderSentAt DateTime? // oxirgi "muddati yaqinlashmoqda" eslatmasi (takror-yubormaslik uchun)
  // Prepaid balans (UZS tiyin) — real Claude chaqiruvlari shundan yechiladi.
  // Balans yetarli bo'lmasa LLM so'rovi hech qachon amalga oshmaydi — shu
  // orqali platforma egasi hech qachon o'z cho'ntagidan to'lamaydi.
  balanceTiyin           BigInt       @default(0)

  // --- SEC-12 §6.1 "Foydalanuvchini bloklash" ---
  // ATAYLAB alohida `status` enum'i EMAS: platformada allaqachon uch xil
  // "to'xtatilgan" o'qi bor (`Agent.frozen`, `platformPlanFrozen`, endi
  // hisob bloki) — ularni bitta status maydoniga siqish mavjud mantiqni
  // qayta yozishni talab qilardi. `blockedAt` — vaqt belgisi sifatida
  // ham bayroq, ham dalil (qachon bloklangani auditda emas, qatorda ham
  // ko'rinadi). `null` = bloklanmagan.
  blockedAt     DateTime?
  blockedReason String?
  /// Bloklagan admin (audit yozuvidan tashqari, qatorda ham ko'rinadi).
  /// FK QO'YILMAGAN — ataylab: bloklagan admin keyinchalik o'chirilsa,
  /// blok holati (xavfsizlik qarori) yo'qolmasligi kerak.
  blockedById   String?

  creditLedger           CreditLedger[]
  paymeTransactions      PaymeTransaction[]
  clickTransactions      ClickTransaction[]
  feedbackItems          Feedback[]
  dangerousActionsRaised DangerousAction[]      @relation("DangerousActionActor")
  dangerousActionsTarget DangerousAction[]      @relation("DangerousActionTarget")
  impersonationsAsActor  ImpersonationSession[] @relation("ImpersonationActor")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
  sharedResults          SharedResult[]
  executionRuns          ExecutionRun[]
  approvalEvents         ApprovalEvent[]
  usageEvents            UsageEvent[]

  // --- Proaktiv haftalik brifing (cron -> Telegram) ---
  // Faqat telegramChatId ulangan foydalanuvchilarga yuboriladi; opt-out mumkin.
  briefingOptIn  Boolean   @default(true)
  lastBriefingAt DateTime?

  // --- Referral (taklif) tizimi — PLG viral halqasi ---
  // referralCode birinchi so'ralganda lazily yaratiladi. referredById faqat
  // ro'yxatdan o'tish paytida BIR MARTA o'rnatiladi (keyin o'zgarmaydi);
  // ikkala tomon ham CreditLedger orqali bonus oladi (kind: referral_bonus).
  referralCode           String? @unique
  referredById           String?
  referredBy             User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]  @relation("Referrals")
  orgId                  String?
  org                    Org?    @relation(fields: [orgId], references: [id])
  isBusinessAccount      Boolean @default(false)
  twoFactorEnabled       Boolean @default(false)
  twoFactorSecret        String?
  twoFactorSecretPending String?
  telegramChatId         String? @unique

  // --- Adaptiv profil (onboarding'da aniqlanadi) ---
  // Foydalanuvchi o'z so'zlari bilan kim ekanini aytadi; tizim kasb/soha'ni aniqlaydi.
  professionTitle     String? // erkin matn: "kardiolog", "do'kon egasi", "fermer"...
  domain              String? // taksonomiya sluglari: healthcare | law | retail | ... | general
  domainConfidence    Float? // 0.0–1.0, aniqlash ishonchi
  onboardingText      String? // foydalanuvchining asl tavsifi (audit/qayta-aniqlash uchun)
  goals               Json? // string[] — foydalanuvchi maqsadlari
  profileData         Json? // { widgets: string[], quick_actions: [...], reasoning: string }
  onboardingCompleted Boolean @default(false)
  // UI mahsulot-turi (sahifama-sahifa "keyingi" tanishtiruvi) ko'rilganmi.
  // onboardingCompleted (kasb aniqlash) dan ALOHIDA — ikkovi turli maqsad.
  tourCompleted       Boolean @default(false)
  preferredLanguage   String  @default("en") // en | ru | uz
  city                String?

  // --- Qadriyatlar profili (Ethical Decision Engine uchun) ---
  // { tradition: "islamic"|"secular"|"mixed", statements: string[] }
  valuesProfile Json?

  twinFacts             TwinFact[]
  userGoals             Goal[]
  agents                Agent[]
  conversations         Conversation[]
  auditLogs             AuditLog[]
  connectorConfigs      ConnectorConfig[]
  automationRuns        AutomationRun[]
  browserSessions       BrowserSession[]
  devicePermissions     DevicePermission[]
  deviceActionLogs      DeviceActionLog[]
  deviceCompanions      DeviceCompanion[]
  deviceCommands        DeviceCommand[]
  callRecordings        CallRecording[]
  retailProducts        RetailProduct[]
  retailSales           RetailSale[]
  visionEvents          VisionEvent[]
  retailAlerts          RetailAlert[]
  retailSettings        RetailSettings?
  reorderDrafts         ReorderDraft[]
  competitorSources     CompetitorSource[]
  competitorPriceChecks CompetitorPriceCheck[]
  employees             Employee[]
  outboundMessages      OutboundMessage[]
  citizenRequests       CitizenRequest[]
  agentReviews          AgentReview[]
  agentInstalls         AgentInstall[]
  creatorLedger         CreatorLedger[]
  payoutsAsCreator      Payout[]               @relation("PayoutCreator")
  payoutsAsBuyer        Payout[]               @relation("PayoutBuyer")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  // Phase 3 / Contract A15: `deletedAt` (soft delete) OLIB TASHLANDI —
  // u hech qayerda filtrlanmasdi, ya'ni "o'chirilgan" foydalanuvchi baribir
  // har so'rovga tushardi. Yagona o'chirish yo'li — GDPR hard-delete +
  // AuditLog (`users.service.deleteAccount()`).

  @@index([clerkId])
  @@index([email])
  @@index([phone])
  // Phase 4 (Rule #25): admin foydalanuvchilar ro'yxati —
  // ORDER BY createdAt DESC, id DESC. Usiz 10k qatorda Seq Scan + Sort edi.
  @@index([createdAt])
  @@index([orgId])
  // SEC-12: admin ro'yxatida "bloklanganlar" filtri (§6.4 Users filtrlari).
  @@index([blockedAt])
}

// Org = AgentOS ish maydoni. Bitta AgentNet hisobi ham shaxs (Life Twin),
// ham tashkilot (C-suite agentlari bilan) bo'lishi mumkin — bir modelning
// kengaytmasi, alohida tizim emas.
model Org {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  clerkOrgId String?      @unique
  // Turi: umumiy tashkilot | davlat organi | startap | yirik korxona
  kind       String       @default("company") // company | government | startup | enterprise
  // Reja bosqichi (billing mantiqisiz — faqat data modeli)
  tier       String       @default("mid") // startup | mid | gov | enterprise
  industry   String?
  ownerId    String? // Org'ni yaratgan foydalanuvchi
  members    User[]
  agents     Agent[]
  commands   OrgCommand[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// Flagman oqim: rahbar bitta buyruq beradi → Orchestrator uni bo'ladi →
// C-suite agentlari bajaradi → bitta hisobotga yig'iladi.
model OrgCommand {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issuedBy  String // foydalanuvchi id
  command   String
  status    String   @default("running") // running | completed | failed
  // { departments: [{ role, title, output, ethics }], report, method }
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

model Agent {
  id                 String         @id @default(cuid())
  name               String
  systemPrompt       String
  model              String         @default("claude-sonnet-5")
  halalFilterEnabled Boolean        @default(true)
  memoryEnabled      Boolean        @default(true)
  // JSON array of ToolSpec: [{ tool_id, config }]
  toolsConfig        Json?
  // AgentOS C-suite roli: null=oddiy shaxsiy agent, aks holda
  // ceo|cfo|cmo|clo|cto — enterprise ish maydoni agentlari
  csuiteRole         String?
  // Vertikal compliance pack: healthcare | finance | government | legal | retail | trade | null
  // Agent yaratilganda shablon domenidan avtomatik belgilanadi; streaming
  // paytida tegishli pack tizim-promptga va chiqish tekshiruviga ulanadi.
  vertical           String?
  description        String?
  // Marketplace'dan o'rnatilgan bo'lsa — manba (nashr etilgan) agent id.
  // Usage/reyting/daromad atributsiyasi shu orqali ishlaydi.
  sourceAgentId      String?
  // Asl yaratuvchi (User.id) — sourceAgentId orqali JOIN qilmasdan doimiy
  // atributsiya uchun (manba agent keyinchalik o'chirilsa ham saqlanadi).
  originalCreatorId  String?
  // Shablon galereyasidan o'rnatilgan bo'lsa — shablon id (registry.ts).
  // Ijtimoiy dalil (REAL install-count) shu orqali hisoblanadi.
  templateId         String?
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  orgId              String?
  org                Org?           @relation(fields: [orgId], references: [id])
  conversations      Conversation[]
  // Agentga ANIQ biriktirilgan konnektorlar. Biriktirilmagan (agentId=null)
  // konnektorlar bu ro'yxatda ko'rinmaydi, lekin agent ularni baribir
  // ishlatadi — ConnectorConfig.agentId izohiga qarang.
  connectorConfigs   ConnectorConfig[]
  isPublished        Boolean        @default(false)
  marketplacePrice   BigInt? // UZS tiyin, null = bepul

  // --- Y4: haqiqiy hisob-kitob (kalkulyator emas — bevosita balansdan yechiladi) ---
  creationPriceTiyin BigInt             @default(0) // yaratishda BIR MARTA yechilgan narx (UZS tiyin)
  monthlyPriceTiyin  BigInt             @default(0) // har oy avtomatik yechiladigan obuna narxi
  frozen             Boolean            @default(false) // balans yetmagach — o'chirilmaydi, "muzlatiladi"
  frozenReason       AgentFrozenReason? // null = muzlatilmagan

  // --- P0-6: KILL SWITCH (SAFETY_POLICY_LAYER §4) ---
  //
  // ⚠️ `frozen` DAN ATAYLAB ALOHIDA. `frozen` — BILLING holati (balans
  // yetmadi, sinov tugadi) va u to'lov bilan avtomatik yechiladi.
  // `killedAt` — XAVFSIZLIK to'xtatuvi: agent noto'g'ri ish qilyapti va
  // uni DARHOL to'xtatish kerak. Ikkalasini bitta maydonga siqish
  // "to'lov qildim — xavfsizlik to'xtatuvi ham yechildi" degan xatoni
  // yaratardi.
  //
  // Kill switch AVTOMATIK o'chmaydi (§4): faqat qo'lda `resume` bilan.
  killedAt     DateTime?
  killedById   String? // FK YO'Q — o'chirilgan admin xavfsizlik qarorini yo'qotmasin
  killReason   String?
  nextChargeAt       DateTime? // keyingi oylik yechim sanasi (monthlyPriceTiyin>0 bo'lsagina)
  chargeRetries      Int                @default(0) // ketma-ket muvaffaqiyatsiz oylik urinishlar soni

  // --- Sinov (FAQAT foydalanuvchining birinchi agenti) ---
  // 3 kun YOKI 20 xabar — qaysi biri oldin tugasa. Tugagach charge-yoki-frozen:
  // balans yetsa jim to'lanadi (oddiy oylik rejimga o'tadi), yetmasa muzlatiladi.
  isTrialAgent      Boolean   @default(false)
  trialStartedAt    DateTime?
  trialMessageCount Int       @default(0)

  // --- Marketplace bozor dinamikasi (agregat hisoblagichlar) ---
  installCount Int     @default(0)
  usageCount   Int     @default(0) // haqiqiy foydalanish hodisalari soni
  successCount Int     @default(0)
  failCount    Int     @default(0)
  ratingAvg    Float?
  ratingCount  Int     @default(0)
  verified     Boolean @default(false) // sifat chegarasidan o'tgan agentlar

  reviews       AgentReview[]
  installs      AgentInstall[] @relation("SourceAgent")
  payouts       Payout[]
  executionRuns ExecutionRun[]
  createdAt     DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  // Phase 3 (Rule #25): kursorli ro'yxat AYNAN shu tartibda o'qiydi —
  // where(userId) + ORDER BY createdAt DESC, id DESC. Mos kompozit indeks
  // bo'lmasa Postgres har sahifa uchun to'liq sort qilardi.
  @@index([userId, createdAt])
  @@index([orgId])
  @@index([isPublished])
  @@index([sourceAgentId])
  @@index([templateId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  // A15 (Contract A12) YAKUNLANDI: xabarlar faqat `Message` jadvalida.
  // Legacy `messages` jsonb ustuni backfill tasdiqlangach tashlandi
  // (20260808120000_phase3_drop_legacy_messages) — Rule #28 zanjiri
  // dual-write -> backfill -> cutover -> drop to'liq yopildi.
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  // Phase 3 (Rule #25): where(userId) + ORDER BY updatedAt DESC, id DESC.
  @@index([userId, updatedAt])
  @@index([agentId])
}

/// Xabar roli (A15). `tool`/`system` — mavjud `ConversationMessage`
/// interfeysi va frontend tiplaridagi qiymatlar (jonli ma'lumotda hozircha
/// faqat user/assistant bor, lekin interfeys shartnomasi to'liq qamraladi).
enum MessageRole {
  user
  assistant
  tool
  system
}

/// A15 (Contract A12 / ADR-009): `Conversation.messages Json` o'rniga
/// normallashgan jadval. Sabab: JSON'da har yangi xabar = butun massivni
/// o'qish+yozish (O(n), TOAST), xabar-darajali pagination/qidiruv/analitika
/// esa umuman mumkin emas edi.
///
/// TARTIB SHARTNOMASI: `(conversationId, createdAt, id)` — `id` (cuid,
/// jarayon ichida monotonik) teng `createdAt`da teng-buzuvchi. Pagination
/// `paginate()` helper orqali (u `id` tiebreaker'ni o'zi qo'shadi).
///
/// Contract A12 ro'yxatidagi `tokensIn/tokensOut` ATAYLAB YO'Q: token
/// ma'lumoti bugun hech qayerda mavjud emas (engine `usage` qaytarishi —
/// Phase 7). Bo'sh ustun qo'shish = o'lik sxema; Phase 7 ularni o'z
/// migratsiyasi bilan qo'shadi.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// Halal-filtr belgisi (faqat assistant xabarlarida bo'lishi mumkin).
  halalFlag      String?
  /// Engine demo rejimda javob bergan (real LLM emas; pul qaytarilgan).
  /// Jonli JSON'da mavjud bo'lgan maydon — ma'lumot saqlanadi.
  demoMode       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// --- Life Twin: foydalanuvchining raqamli egizagi (ma'lumot umurtqasi) ---
// Har bir fakt — foydalanuvchi hayotining bitta bo'lagi. Boshqa barcha
// aqlli funksiyalar (what-if, goals, supermode) shu faktlarni o'qiydi.
model TwinFact {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String // health | finance | family | work | habits | education | other
  label      String // masalan: "Oylik daromad"
  value      String // masalan: "8 mln so'm"
  source     String   @default("manual") // onboarding | conversation | manual | agent
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
}

// --- Autonomous Goal Achievement ---
model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String     @default("active") // active | paused | completed
  progress    Int        @default(0) // 0-100, tugallangan tasklar ulushi
  plan        Json? // { milestones, reasoning, method }
  tasks       GoalTask[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

model GoalTask {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?
  agentRole   String? // qaysi turdagi agent bajaradi (masalan: "accountant")
  cadence     String? // once | daily | weekly
  status      String    @default("pending") // pending | done | skipped
  result      String? // bajarilgandan keyingi natija matni
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([goalId])
  @@index([status])
}

model AuditLog {
  id                 String   @id @default(cuid())
  // Monotonik ketma-ketlik — hash-zanjirning "oxirgi" yozuvini bir ma'noda
  // aniqlaydi (createdAt millisekundda teng bo'lib qolishi mumkin, seq — hech qachon).
  seq                Int      @unique @default(autoincrement())
  actorId            String
  actor              User     @relation(fields: [actorId], references: [id])
  action             String // masalan: "auth.login", "agent.create", "halal_filter.block"
  resourceType       String // masalan: "user", "agent", "conversation"
  resourceId         String?
  metadata           Json?
  /// SEC-12 / ADR-008: impersonation orqali bajarilgan amalda — KO'RILGAN
  /// foydalanuvchi. `actorId` esa DOIM haqiqiy operator bo'lib qoladi, ya'ni
  /// "foydalanuvchi o'zi qildi" va "admin uning nomidan qildi" hech qachon
  /// chalkashmaydi (§11).
  ///
  /// KANONIK HASH O'ZGARMAYDI (§12 talabi): bu ustun `computeEntryHash`
  /// kirishida YO'Q — mavjud zanjir formati buzilmasin. Buzilmas nusxa
  /// `metadata.impersonatedUserId` da yashaydi (metadata hash ichida), ya'ni
  /// bu ustun faqat INDEKSLANADIGAN ko'chirma: uni o'zgartirish dalilni
  /// o'zgartirmaydi (metadata bilan solishtirilganda darhol ko'rinadi).
  impersonatedUserId String?
  // Hash-chain: har bir yozuv oldingi yozuv hash'iga bog'langan
  prevHash           String
  entryHash          String   @unique
  createdAt          DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  // SEC-12 §6.4: "impersonation tarixi" — nishon bo'yicha jurnal.
  @@index([impersonatedUserId, seq])
}

// Ulashilgan natija — foydalanuvchi agenti chiqargan natijaning (masalan "bu oy
// do'kon tushumi") ommaviy suratkashi. `token` orqali /s/<token> public sahifada
// ochiladi ("AgentNet bilan yaratilgan" watermark bilan) — PLG viral halqasi.
// Snapshot: yaratilgan paytdagi qiymatlar saqlanadi (keyin o'zgarmaydi).
model SharedResult {
  id        String   @id @default(cuid())
  token     String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind      String   @default("generic") // retail_forecast | twin | generic | ...
  title     String
  subtitle  String?
  metrics   Json? // [{ label, value, hint? }] — asosiy raqamlar
  body      String? // ixtiyoriy erkin matn
  locale    String?  @default("uz")
  views     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Foydalanuvchi fikri/shikoyati/savoli — Yordam panelidan yuboriladi.
// Admin (OWNER roli) ko'rib chiqadi. `page` va `locale` — kontekst uchun.
model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String         @default("suggestion") // suggestion | bug | question
  message   String
  page      String? // qaysi sahifadan yuborilgan
  locale    String? // uz | ru | en
  status    FeedbackStatus @default(new)
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([status])
  // Phase 4 (Rule #25): admin fikrlar ro'yxati — status filtri + createdAt tartibi.
  @@index([status, createdAt])
  @@index([createdAt])
}

// Bir martalik login kodi (email/SMS OTP). Kod o'zi saqlanmaydi — faqat
// sha256(kod+pepper) hash'i, shuning uchun DB dampi o'g'irlansa ham kodlar
// ochilmaydi. `identifier` — normallashtirilgan email yoki E.164 telefon.
model OtpCode {
  id         String    @id @default(cuid())
  identifier String
  channel    String // "email" | "phone"
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier])
}

// ================================================================
// PART 1B — Platform-wide superpowers
// ================================================================

// --- S1: Universal App Control (Tier 1 — brauzer avtomatlashtirish) ---
// Har bir yurgizish: maqsad → LLM-rejalashtirilgan qadamlar (Playwright) →
// qadam jurnali + yakuniy natija. Tier 2 (native OS) ROADMAP'da.
model AutomationRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  startUrl  String?
  status    String   @default("running") // running | completed | failed | blocked
  // [{ step, action, target, value?, observation, at }]
  steps     Json?
  result    Json? // { summary, extracted?, finalUrl, finalTitle }
  method    String? // llm | scripted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// --- BOSQICH 0: Brauzer-agent sessiyalari ---
// Foydalanuvchi maqsadli saytga BIR MARTA login qiladi; Playwright storageState
// (cookie + localStorage) shu yerda SHIFRLANGAN holda (CryptoService, AES-256-GCM)
// saqlanadi va har brauzer-run'da kontekstga in'ektsiya qilinadi — shunda agent
// foydalanuvchining login-sessiyasida ishlaydi. Parol HECH QACHON saqlanmaydi.
// Har sayt (domen) uchun alohida yozuv; run paytida hammasi birlashtiriladi
// (universal — foydalanuvchi ulagan istalgan ilovaga kira oladi).
model BrowserSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      String // masalan "instagram.com" — sessiya qaysi sayt uchun
  label       String? // foydalanuvchi bergan nom (ixtiyoriy)
  state       String // SHIFRLANGAN storageState JSON (CryptoService)
  cookieCount Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}

// --- BOSQICH 1: Qurilma Boshqaruvi (Device Control) ---
// Real qurilmaga ruxsat — xavfsizlik-modeli boshqa agentlardan BUTUNLAY farqli.
// Har qurilma (computer | phone) va har toifa (files, browser, apps, calls, sms,
// screen) uchun ALOHIDA yoqish/o'chirish. Sukut bo'yicha HAMMASI o'chiq — agent
// faqat foydalanuvchi ochiq ruxsat bergan toifada ish qila oladi.
model DevicePermission {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType String // "computer" | "phone"
  category   DeviceCategory
  enabled    Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, deviceType, category])
  @@index([userId])
}

// Xavfsizlik-log: agent bajargan HAR harakat ("Telegram ochildi", "SMS yuborildi")
// shu yerga yoziladi — foydalanuvchi "agent nima qildi" tarixini ko'ra oladi.
model DeviceActionLog {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType String // computer | phone | browser
  category   DeviceActionCategory
  action     String // inson-o'qiydigan tavsif
  detail     String?
  status     String               @default("ok") // ok | blocked | failed
  createdAt  DateTime             @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// --- BOSQICH 2/3: Companion (yordamchi ilova) — desktop & Android ---
// Real qurilmani server BEVOSITA boshqara olmaydi; foydalanuvchi mashinasiga/
// telefoniga companion o'rnatiladi va juftlash-kodi orqali bog'lanadi. Companion
// buyruqlarni oladi (poll), bajaradi va natijани qaytaradi. Har amal DevicePermission
// bilan cheklangan (fail-closed) va DeviceActionLog'ga yoziladi.
model DeviceCompanion {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             String // "computer" | "phone"
  name             String?
  pairingCode      String?         @unique // faol juftlash-kodi (ulanguncha); ulangach null
  // SEC-01: kod 10 daqiqadan keyin amal qilishdan to'xtaydi (pair() shuni tekshiradi).
  pairingExpiresAt DateTime?
  tokenHash        String? // companion auth-tokeni (sha256 hash — xom token faqat companion'da)
  // SEC-01: joriy tokenning berilgan vaqti — 30-kunlik rotatsiya siyosati shundan hisoblanadi
  // (companion.mjs muddat yaqinlashganda /companion/refresh chaqiradi).
  tokenIssuedAt    DateTime?
  status           String          @default("pending") // pending | paired | offline
  pairedAt         DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  commands         DeviceCommand[]

  @@index([userId])
}

// Buyruq-navbati. B3 (telefon) Intent-MVP: send_sms/call/open_app (ekran-nazoratsiz,
// ishonchli). B2 (desktop) computer_use: skrinshot->vision->harakat loop.
model DeviceCommand {
  id          String          @id @default(cuid())
  companionId String
  companion   DeviceCompanion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        CommandKind
  payload     Json // {to,text} | {to} | {package|appName} | {goal}
  status      CommandStatus   @default(queued)
  result      Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companionId, status])
  @@index([userId])
}

// --- BOSQICH 5: Qo'ng'iroqni yozib olish (huquqiy ogohlantirish bilan) ---
// Yozuv SHIFRLANGAN saqlanadi (CryptoService). Yaratish uchun foydalanuvchi
// majburiy huquqiy ogohlantirishni TASDIQLASHi shart (consentAck) — ba'zi
// mamlakatlarda rozilik-siz yozib olish noqonuniy, javobgarlik foydalanuvchida.
model CallRecording {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  mimeType      String   @default("audio/webm")
  durationSec   Int      @default(0)
  data          String // SHIFRLANGAN audio (base64 -> CryptoService)
  consentAck    Boolean  @default(false) // huquqiy ogohlantirish tasdiqlangan
  partyNotified Boolean  @default(false) // ikkinchi tomon ogohlantirilganmi (imkon bo'lsa)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// --- S2: Connector SDK ---
// Bitta yagona interfeys: auth + action schema + data schema.
// Connector ta'riflari kodda (registry), foydalanuvchi konfiglari shu jadvalda.
model ConnectorConfig {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectorId String // registry slug: "telegram-bot", "whatsapp-business", ...
  // Qaysi agent bu konnektorni ishlata oladi.
  //   null  = foydalanuvchining BARCHA agentlari (Ulanishlar sahifasining
  //           "Bir marta ulang — barcha agentlar foydalanadi" va'dasi; mavjud
  //           yozuvlar migratsiyadan keyin aynan shu holatda qoladi)
  //   to'la = FAQAT shu agent ko'radi (bir agentga xos bot/do'kon/hisob).
  // Agent o'chirilsa unga xos konfiguratsiya ham ketadi (Cascade) — bu sirlar
  // ortda qolib ketmasligi uchun.
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label       String    @default("default")
  // Auth + sozlamalar (token, chat_id, shop domain...). At-rest AES-256-GCM
  // bilan shifrlangan saqlanadi (CryptoService) — bu ustunda shifrlangan blob.
  config      Json?
  status      String    @default("connected") // connected | needs_credentials | error | disabled
  lastUsedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, connectorId, label])
  @@index([userId])
  @@index([agentId])
}

// --- S4: Retail Intelligence (kamera + inventar fuziyasi) ---
model RetailProduct {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  stock        Int      @default(0)
  reorderLevel Int      @default(5)
  price        Int      @default(0) // UZS tiyin
  shelfZone    String? // kamera zonasi bilan bog'lash uchun: "A1", "ichimliklar"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, sku])
  @@index([userId])
}

model RetailSale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       String
  qty       Int      @default(1)
  total     Int      @default(0) // UZS tiyin
  source    String   @default("pos") // pos | manual | import
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, sku])
  @@index([createdAt])
}

// Kamera-vision hodisasi — haqiqiy CV servis webhook orqali yuboradi
// (POST /api/retail/vision-events). Hodisa O'ZI signal emas: POS/inventar
// bilan solishtirilgandan keyingina alert bo'ladi.
model VisionEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera     String   @default("cam-1")
  type       String // shelf_empty | item_pickup | shelf_restocked | person_loitering | unknown
  sku        String?
  zone       String?
  confidence Float    @default(0.8)
  raw        Json?
  status     String   @default("new") // new | reconciled | alerted | dismissed
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model RetailAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // stockout | restock_needed | theft_suspect | discrepancy | false_alarm
  severity  String   @default("info") // info | warning | critical
  title     String
  body      String
  evidence  Json? // { visionEvents, inventory, sales, assessment }
  channel   String? // telegram | sms | email | whatsapp | in_app
  delivery  String   @default("pending") // sent | pending | failed | in_app
  method    String? // llm | heuristic
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([kind])
}

model RetailSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String   @default("telegram") // telegram | sms | email | whatsapp
  target     String? // chat_id / telefon / email
  autoNotify Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

// Avtonom buyurtma qoralamasi — reorderPlan() tomonidan hisoblanadi, lekin
// HECH QACHON o'zi yuborilmaydi. Egasi "Tasdiqlash"/"Bekor qilish" bilan bir
// marta ko'rib chiqadi (ishonch qozonish MVP talabi). Bitta sku uchun bitta
// faol (pending) yozuv — kun ichida qayta tasdiqlashga majburlamaslik uchun
// qaror qabul qilingandan keyin bir kun davomida qayta ko'tarilmaydi.
model ReorderDraft {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku               String
  name              String
  urgency           String
  stock             Int
  dailyVelocity     Float
  daysUntilStockout Float?
  orderQty          Int
  message           String
  status            String    @default("pending") // pending | approved | rejected
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, sku])
  @@index([userId])
  @@index([status])
}

// Raqobatchi narx manbasi — foydalanuvchi qo'lda kiritgan narx yoki ochiq
// e'lonlar sayti URL'i. Kunlik cron shu ro'yxatni aylanib chiqadi.
model CompetitorSource {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku         String
  name        String // masalan: "Qo'lda", "OLX", "Uzum Market"
  url         String? // null = qo'lda kiritilgan narx (manualPrice ishlatiladi)
  manualPrice Int? // UZS tiyin
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checks CompetitorPriceCheck[]

  @@index([userId])
  @@index([userId, sku])
}

// Har kunlik tekshiruv natijasi (log) — jonli emas, kunlik snapshot.
model CompetitorPriceCheck {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String
  source    CompetitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sku       String
  price     Int? // UZS tiyin; null = topilmadi
  ok        Boolean          @default(true)
  error     String?
  checkedAt DateTime         @default(now())

  @@index([userId])
  @@index([sourceId])
  @@index([userId, sku])
}

// --- S5: Business Operations (AgentOS kengaytmasi) ---
model Employee {
  id          String    @id @default(cuid())
  userId      String // ish beruvchi (workspace egasi)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId       String?
  name        String
  role        String?
  phone       String?
  email       String?
  hourlyRate  Int? // UZS tiyin/soat
  monthlyRate Int? // UZS tiyin/oy
  active      Boolean   @default(true)
  shifts      Shift[]
  timeOffs    TimeOff[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     String
  date       String // YYYY-MM-DD
  startTime  String // "09:00"
  endTime    String // "18:00"
  status     String   @default("scheduled") // scheduled | completed | missed | cancelled
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, date])
  @@index([employeeId])
}

model TimeOff {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     String
  startDate  String // YYYY-MM-DD
  endDate    String // YYYY-MM-DD
  kind       String   @default("vacation") // vacation | sick | unpaid | other
  status     String   @default("pending") // pending | approved | rejected
  reason     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([employeeId])
}

// Tashqi kommunikatsiya: agent qoralama tayyorlaydi (draft), egasi
// tasdiqlaydi (approved), keyin Connector SDK orqali haqiqiy yuboriladi (sent).
model OutboundMessage {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId            String?
  audience         String    @default("client") // client | partner | sponsor
  recipientName    String?
  recipientContact String // chat_id / email / telefon
  channel          String    @default("telegram") // telegram | email | sms | whatsapp
  subject          String?
  body             String
  status           String    @default("draft") // draft | approved | sent | failed
  sentAt           DateTime?
  meta             Json? // { purpose, method, deliveryResult }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

// --- S7: GovTech — fuqaro so'rovi (mahalla/tuman raqamlashtirish) ---
// Intake → tasnif → mas'ul xizmatga yo'naltirish → holat kuzatuvi.
// Jonli davlat tizimiga topshirish data-sharing shartnomasini talab qiladi —
// hozir ichki marshrutlangan tiket sifatida ishlaydi (routing.live=false).
model CitizenRequest {
  id        String   @id @default(cuid())
  userId    String // operator (mahalla xodimi) yoki fuqaroning o'zi
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  contact   String?
  text      String
  category  String? // utilities | roads | documents | social | sanitation | dispute | other
  service   String? // mas'ul xizmat nomi
  office    String? // idora/portal
  priority  String? // low | normal | high | urgent
  routing   Json? // { service, office, steps, live: false, method }
  status    String   @default("received") // received | routed | in_progress | resolved | rejected
  timeline  Json? // [{ at, status, note }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// --- S8: Marketplace bozor mexanikasi ---
model AgentInstall {
  id               String   @id @default(cuid())
  sourceAgentId    String
  sourceAgent      Agent    @relation("SourceAgent", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  installedAgentId String   @unique
  userId           String // o'rnatgan foydalanuvchi
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pricePaid        BigInt   @default(0) // UZS tiyin
  createdAt        DateTime @default(now())

  @@index([sourceAgentId])
  @@index([userId])
}

model AgentReview {
  id        String   @id @default(cuid())
  agentId   String // nashr etilgan (manba) agent
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([agentId, userId])
  @@index([agentId])
}

// Kreator daromad daftari — har bir yozuv haqiqiy buxgalteriya:
// install_revenue (70% kreator ulushi), usage_revenue, payout (manfiy).
// To'lov protsessingi stub — hisob-kitob mantig'i haqiqiy.
model CreatorLedger {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  agentId   String?
  kind      String // install_revenue | usage_revenue | payout
  amount    BigInt // UZS tiyin; kredit musbat, payout manfiy
  currency  String   @default("UZS")
  meta      Json? // { installId, grossAmount, platformShare, note }
  createdAt DateTime @default(now())

  @@index([creatorId])
  @@index([agentId])
}

// Y5: "yaratuvchi bonusi" — CreatorLedger'dagi 70/30 daromad ulushidan ALOHIDA:
// yangi xaridor birinchi to'lovni amalga oshirganda creation_price'ning yarmi
// original yaratuvchiga BIR MARTALIK bonus sifatida HAQIQIY balansiga tushadi.
// @@unique([agentId, buyerId]) — bir buyer bitta manba agent uchun faqat BIR
// marta bonus keltiradi (keyingi oylik to'lovlarda QAYTA berilmaydi).
model Payout {
  id                String   @id @default(cuid())
  agentId           String // manba (nashr etilgan) agent id
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  originalCreatorId String
  originalCreator   User     @relation("PayoutCreator", fields: [originalCreatorId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User     @relation("PayoutBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  bonusAmountTiyin  BigInt
  paidAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([agentId, buyerId])
  @@index([originalCreatorId])
  @@index([buyerId])
}

// --- Foydalanish limitlari (rate limiting / xarajat himoyasi) ---
// userId = foydalanuvchi id yoki "_global" (butun platforma bo'yicha kunlik LLM hisobi)
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  day    String // "YYYY-MM-DD" (UTC)
  kind   String // "chat" | "heavy" | "llm"
  count  Int    @default(0)

  @@unique([userId, day, kind])
  @@index([day])
}

// --- Prepaid billing (foydalanuvchi o'zi uchun to'laydi, platforma emas) ---

// Balans o'zgarishlari — real buxgalteriya yozuvi (marketplace'dagi CreatorLedger
// bilan bir xil naqsh). kind: topup | usage | refund | bonus
model CreditLedger {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           LedgerKind
  amount         BigInt // UZS tiyin; kredit musbat, xarajat manfiy
  balanceAfter   BigInt // yozuv vaqtidagi yakuniy balans (audit uchun)
  meta           Json?
  // Mijoz tomonidan generatsiya qilingan bir martalik kalit — pul bilan
  // ishlaydigan amallar (agent yaratish/oylik yechim) bir xil so'rov ikki
  // marta yuborilsa ham IKKINCHI marta yechilmasligi uchun (DB-darajasidagi
  // himoya — parallel so'rovlarda ham ishlaydi).
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  @@index([userId])
  // Phase 3 (Rule #25): balans tarixi — where(userId) + sana bo'yicha tartib.
  @@index([userId, createdAt])
  @@index([kind])
}

// Payme Merchant API (JSON-RPC) tranzaksiyalari — haqiqiy to'lov protokoli.
// Paycom bu yozuvni CheckPerformTransaction/CreateTransaction/PerformTransaction/
// CancelTransaction chaqiruvlari bilan boshqaradi. state: 1=yaratildi (kutilmoqda),
// 2=bajarildi (balans kreditlandi), -1=bekor qilindi (kutilayotgan),
// -2=bekor qilindi (bajarilgandan keyin).
model PaymeTransaction {
  id            String   @id @default(cuid())
  paycomId      String   @unique // Payme tomonidan yuboriladigan tranzaksiya id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountTiyin   BigInt
  state         Int      @default(1)
  reason        Int? // bekor qilish sababi (Payme error code)
  createTimeMs  BigInt
  performTimeMs BigInt?
  cancelTimeMs  BigInt?
  createdAt     DateTime @default(now())

  // "topup" (balansni to'ldirish) | "platform_subscription" (Pro/Max obunasi
  // — muvaffaqiyatli to'lov wallet'ga EMAS, User.platformPlan'ga ta'sir qiladi)
  purpose          PaymentPurpose @default(topup)
  subscriptionPlan String? // purpose="platform_subscription" bo'lsa: "pro" | "max"

  @@index([userId])
  @@index([state])
}

// Click Merchant API (Prepare/Complete) tranzaksiyalari — real protokol
// https://docs.click.uz. merchant_trans_id = userId (Payme'dagi account.user_id
// bilan bir xil naqsh — bitta hisobga to'lov). state: 0=prepared (kutilmoqda),
// 1=bajarildi (balans kreditlandi), -1=bekor qilindi (prepare bosqichida),
// -2=bekor qilindi (bajarilgandan keyin).
model ClickTransaction {
  id            String   @id @default(cuid())
  clickTransId  String   @unique // Click tomonidan yuboriladigan click_trans_id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountTiyin   BigInt
  state         Int      @default(0)
  errorCode     Int?
  prepareTimeMs BigInt?
  confirmTimeMs BigInt?
  cancelTimeMs  BigInt?
  createdAt     DateTime @default(now())

  // "topup" (balansni to'ldirish) | "platform_subscription" (Pro/Max obunasi)
  purpose          PaymentPurpose @default(topup)
  subscriptionPlan String? // purpose="platform_subscription" bo'lsa: "pro" | "max"

  @@index([userId])
  @@index([state])
}

// ----------------------------------------------------------------
// V3-P0 · P0-13 (Event Bus) + P0-7 (Trace) — ijro izi
// Blueprint: docs/blueprints/P0_BLUEPRINT.md §2.3, P0-7 §6
// ----------------------------------------------------------------

/// Bitta agent ijrosi (run). Hodisalar shunga bog'lanadi.
///
/// `status`/`endedAt`/`stepCount` — YAKUNIY holatning tezkor nusxasi.
/// Hodisalar append-only bo'lgani uchun yakun `RUN_COMPLETED`/`RUN_FAILED`
/// hodisasi bilan e'lon qilinadi; bu ustunlar esa ro'yxat va filtr uchun
/// (har safar butun hodisa zanjirini skanerlamaslik uchun).
model ExecutionRun {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId String?
  status         RunStatus @default(RUNNING)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  /// Konstitutsiya #20: pul — BigInt tiyin, float HECH QACHON.
  totalCostTiyin BigInt    @default(0)
  stepCount      Int       @default(0)

  events ExecutionEvent[]

  @@index([userId, startedAt])
  @@index([agentId, startedAt])
  @@index([status])
}

/// Kanonik ijro hodisasi (blueprint §2.3 konverti).
///
/// APPEND-ONLY: yozuv hech qachon yangilanmaydi va o'chirilmaydi
/// (retention bundan mustasno — P0-15).
///
/// `payload` HAR DOIM redaksiyadan o'tgan (§2.3.1) — xom sir, xom tool
/// argumenti va DOM matni bu ustunga tushmaydi. Redaksiya
/// `ExecutionEventBus.emit()` ichida MAJBURIY va uni chetlab o'tib
/// bo'lmaydi (yagona yozuv nuqtasi).
model ExecutionEvent {
  id     String       @id @default(cuid())
  runId  String
  run    ExecutionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId String?
  /// Run ichida MONOTONIK. `createdAt` millisekundda teng bo'lib qolishi
  /// mumkin, `seq` — hech qachon (AuditLog.seq bilan bir xil mantiq).
  seq    Int

  type      ExecutionEventType
  actor     EventActor
  agentId   String
  /// Bugungi tenant modelida = `userId`. Alohida ustun ATAYLAB: org-darajali
  /// tenant kelganda hodisa sxemasi o'zgarmasligi uchun.
  tenantId  String
  payload   Json?
  costTiyin BigInt?
  latencyMs Int?
  createdAt DateTime           @default(now())

  /// Dublikat hodisa (retry) ikkinchi marta yozilmaydi.
  @@unique([runId, seq])
  @@index([runId, seq])
  @@index([tenantId, createdAt])
}

/// V3-P0 · P0-5 — FOYDALANISH O'LCHOVI (metering).
///
/// ADR-023: platforma har chaqiruvda qancha yo'qotayotganini BILMAYDI.
/// Bu jadval o'sha bo'shliqni yopadi — G0.1 (qamrov ≥95%) va G0.2
/// (gross margin raqami MAVJUD) ikkalasi ham shundan o'lchanadi.
///
/// ⚠️ SHADOW REJIM: yoziladi, lekin foydalanuvchi hisobiga TA'SIR
/// QILMAYDI (ADR-023 §5). Narx o'zgarishi — V3-P1 ishi.
///
/// ⚠️ `Message.tokensIn/tokensOut` ATAYLAB QO'SHILMADI. Sxemadagi
/// mavjud izoh (Message modeli ustida) "bo'sh ustun = o'lik sxema"
/// deydi; endi ma'lumot bor, lekin uni IKKI joyda saqlash ikkita
/// haqiqat manbai yaratardi. `UsageEvent` da `conversationId` bor —
/// suhbat bo'yicha token yig'indisi shundan olinadi.
model UsageEvent {
  id String @id @default(cuid())
  /// `runId + stepId` (§2.2) — retry dublikat yozuv yaratmaydi.
  idempotencyKey String @unique

  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String?
  runId          String?
  conversationId String?

  kind  UsageKind
  model String?

  // PRICING_ARCHITECTURE §2.1 o'lchamlari (U1–U10).
  inputTokens     Int    @default(0) // U1
  outputTokens    Int    @default(0) // U2
  cacheReadTokens Int    @default(0) // U10 — arzonlashtiruvchi
  toolCalls       Int    @default(0) // U4
  browserMs       Int    @default(0) // U5
  visionOps       Int    @default(0) // U6
  connectorCalls  Int    @default(0) // U7
  executionMs     Int    @default(0) // U8
  storageBytes    BigInt @default(0) // U9

  /// BIZGA qancha turdi (Konstitutsiya #20: BigInt tiyin, float YO'Q).
  /// ⚠️ Bu ICHKI ma'lumot — oddiy foydalanuvchiga hech qachon qaytarilmaydi.
  internalCostTiyin BigInt @default(0)
  /// Model narx jadvalida topilmadi — `internalCostTiyin` ishonchsiz.
  /// Jim 0 o'rniga ANIQ belgi (aks holda marja soxta yaxshi ko'rinardi).
  costUnknown Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([runId])
  @@index([createdAt])
}

/// O'lchov turi — qaysi resurs sarflandi.
enum UsageKind {
  LLM
  TOOL
  BROWSER
  VISION
  CONNECTOR
  STORAGE
}

/// P0-8 — LangGraph ijro holati (checkpoint).
///
/// ⚠️ NEGA API'DA, ENGINE'DA EMAS: `apps/agent-engine` da hech qanday DB
/// kutubxonasi yo'q va u Postgres'ga UMUMAN ulanmaydi — API bilan faqat
/// HTTP orqali gaplashadi. `langgraph-checkpoint-postgres` ni engine'ga
/// qo'shish unga DB kredensiallarini berish, ya'ni arxitektura chegarasini
/// ochish bo'lardi (engine buzilsa — to'g'ridan-to'g'ri baza).
///
/// Shuning uchun: holat AYNAN KERAKLI joyda — Postgres'da (Contract A10,
/// yagona haqiqat manbai), lekin unga yozish API orqali. Engine tomonda
/// `ApiCheckpointSaver` (`BaseCheckpointSaver`) `/internal/checkpoints`
/// endpointiga boradi.
///
/// `blob` — LangGraph serializatori chiqishi (base64). Ichida XOM SIR
/// BO'LMASLIGI kerak: sirlar modelga `secretRef` sifatida beriladi (P0-9),
/// checkpoint esa faqat ichki holatni saqlaydi (blueprint §2.1 T5).
model AgentCheckpoint {
  id String @id @default(cuid())
  /// LangGraph `thread_id` — bizda `ExecutionRun.id` (blueprint §2.9 M3:
  /// holat RUNGA bog'langan, ulanishga emas).
  threadId String
  /// LangGraph checkpoint identifikatori (ULID-simon, tartibli).
  checkpointId String
  /// Ota-checkpoint — tarix zanjiri (`before`/resume uchun).
  parentCheckpointId String?
  /// `checkpoint_ns` — subgraph nommaydoni; asosiy grafda bo'sh satr.
  checkpointNs String @default("")

  blob     String
  metadata Json?

  createdAt DateTime @default(now())

  /// Bir thread ichida bir checkpoint IKKI MARTA yozilmaydi (retry xavfsiz).
  @@unique([threadId, checkpointNs, checkpointId])
  /// `get_tuple` (oxirgisi) va `list` (tarix) — ikkalasi ham shu indeksdan.
  @@index([threadId, checkpointNs, createdAt])
}

/// P0-8 — tugun yozuvlari (`put_writes`).
///
/// LangGraph tugun natijalarini checkpointdan ALOHIDA yozadi: ular
/// keyingi checkpoint qurilishida qo'llaniladi. Bitta jadvalga siqish
/// `get_tuple` ni noto'g'ri qilardi.
model AgentCheckpointWrite {
  id           String @id @default(cuid())
  threadId     String
  checkpointNs String @default("")
  checkpointId String
  taskId       String
  /// Yozuv tartibi — LangGraph ularni AYNAN shu tartibda qayta o'qiydi.
  idx      Int
  channel  String
  blob     String

  createdAt DateTime @default(now())

  @@unique([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs, checkpointId])
}

/// P0-6 — INSON TASDIG'I HODISASI (SAFETY_POLICY_LAYER §8).
///
/// Bu jadval — UI elementi emas, **ma'lumot aktivi**: "inson qaysi amalni
/// tasdiqladi/rad etdi/TUZATDI" korpusi (MASTER_ROADMAP §2 M3). U retroaktiv
/// tiklab bo'lmaydi — bugun yig'ilmasa hech qachon olinmaydi.
///
/// `modifiedAction` — eng qimmatli maydon: inson agent taklifini AYNAN nimaga
/// o'zgartirgani. Aynan shu ma'lumot keyinchalik agentni yaxshilashga xizmat
/// qiladi va uni hech qanday tashqi manbadan sotib olib bo'lmaydi.
///
/// Retention: P0-15 jadvalida **365 kun** (moat) va retention cron'idan
/// CHIQARILGAN; faqat foydalanuvchi o'chirilganda kaskad bilan ketadi.
model ApprovalEvent {
  id      String  @id @default(cuid())
  runId   String
  stepId  String?
  /// Qaysi tool chaqiruvi — idempotency kaliti bilan bir xil o'q (§2.2).
  actionId String
  agentId String
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  riskTier RiskTier
  /// Agent NIMA taklif qildi (redaksiyalangan — §2.3.1).
  proposedAction Json
  decision       ApprovalDecision
  /// ⭐ `MODIFIED` bo'lsa MAJBURIY: inson nimani tuzatdi.
  modifiedAction Json?
  /// Qaror qancha vaqt oldi — ishonch signali (tez "ha" = ko'r-ko'rona tasdiq).
  latencyMs Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([runId])
}
